# =========================================================================
# Spring Boot Core & Build Targets
# =========================================================================
target/
build/
bin/
out/
HELP.md
.mvn/wrapper/maven-wrapper.jar

# Prevent deep target or build tracking overrides
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# =========================================================================
# Environment Secrets & Local Runtime Properties
# =========================================================================
# Blocks local database setups, runtime properties, and environmental keys
.env
.env.local
*.properties.local
*.env.production

